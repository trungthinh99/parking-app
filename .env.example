# API - parking-api base URL (use LAN IP for real device access)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.160:3000/api

# Kakao Map API Key
EXPO_PUBLIC_KAKAO_MAP_APP_KEY=

# Kakao REST API Key (for Local search API - address/keyword search)
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# Restore last visited tab on app restart (dev convenience)
EXPO_PUBLIC_RESTORE_LAST_TAB=