{
  "expo": {
    "name": "Parking Research",
    "slug": "parking-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkingmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#238AAF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.psys.parking",
      "associatedDomains": ["applinks:test-parking.duckdns.org"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 위치를 지도에 표시하기 위해 위치 정보가 필요합니다."
      }
    },
    "android": {
      "package": "com.psys.parking",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "test-parking.duckdns.org",
              "pathPrefix": "/i/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 지도에 표시하기 위해 위치 정보가 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "주차장 사진을 첨부하기 위해 사진첩 접근 권한이 필요합니다.",
          "cameraPermission": "주차장 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
